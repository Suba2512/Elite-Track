# ============================================================================
# ELITE TRACK BACKEND (Obj3) - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
TIMEZONE=Asia/Kolkata

# Database Configuration (SQLite default with zero external dependencies)
DATABASE_PATH=./data/elitetrack.db
# Optional PostgreSQL URL if Supabase or external DB is used:
# DATABASE_URL=postgresql://user:password@localhost:5432/elitetrack

# Discovery Scheduling (in minutes)
DISCOVERY_INTERVAL_HACKATHONS_MINUTES=360
DISCOVERY_INTERVAL_CONTESTS_MINUTES=120
VERIFICATION_INTERVAL_MINUTES=720
REMINDERS_INTERVAL_MINUTES=60

# Meta WhatsApp Business Cloud API Configuration
# Official docs: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_ACCESS_TOKEN="YOUR_META_WHATSAPP_SYSTEM_USER_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_META_BUSINESS_ACCOUNT_ID"
WHATSAPP_VERIFY_TOKEN="elite_track_secure_webhook_verify_token_2026"
WHATSAPP_APP_SECRET="YOUR_META_APP_SECRET"

# Mentor & System Configuration
MENTOR_DEFAULT_ID="mentor-ganesh"
MENTOR_NAME="Ganesh Sir"
